{
  "name": "yatraflow",
  "version": "0.72.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "pwsh -NoProfile -File scripts/start.ps1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:integration": "node scripts/integration/integrationHarness.mjs",
    "check:migrations": "node scripts/checkMigrations.mjs",
    "clean:env": "node scripts/clean-env.mjs",
    "lint": "eslint src",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "lint:ste": "node scripts/lint-ste.mjs",
    "verify": "tsc -b --clean && npm run lint:ratchet && npm test && npm run build"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@supabase/supabase-js": "^2.112.4",
    "@vercel/analytics": "^2.0.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.34.0",
    "maplibre-gl": "^6.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
