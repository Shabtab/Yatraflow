{
  "name": "yatraflow",
  "version": "0.50.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "pwsh -NoProfile -File scripts/start.ps1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src",
    "verify": "tsc -b --clean && npm test && npm run build"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
