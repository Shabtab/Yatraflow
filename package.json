{
  "name": "yatraflow",
  "version": "0.86.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ui:sweep": "node scripts/ui-sweep.mjs",
    "start": "pwsh -NoProfile -File scripts/start.ps1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:changed": "node scripts/test-changed.mjs",
    "test:integration": "node scripts/integration/integrationHarness.mjs",
    "check:migrations": "node scripts/checkMigrations.mjs",
    "clean:env": "node scripts/clean-env.mjs",
    "check:ui": "node scripts/uiAntipatterns.mjs",
    "check:css": "node scripts/css-ownership.mjs",
    "art:build": "node scripts/build-art.mjs",
    "check:motion": "npm run build && node scripts/browser-motion-check.mjs",
    "probe:landing-overflow": "node scripts/landing-overflow-probe.mjs",
    "probe:next-step": "node scripts/next-step-probe.mjs",
    "lint": "eslint src",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "lint:ste": "node scripts/lint-ste.mjs",
    "changelog:new": "node scripts/changelog.mjs new",
    "changelog:check": "node scripts/changelog.mjs check",
    "changelog:release": "node scripts/changelog.mjs release",
    "verify": "tsc -b --clean && tsc -b && npm run typecheck:tests && npm run lint:ratchet && npm run lint:ste && npm run changelog:check && npm run check:css && npm test && vite build",
    "verify:typecheck": "tsc -b --clean && tsc -b",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "verify:fast": "node scripts/verify-fast.mjs",
    "hooks:install": "node scripts/hooks.mjs install",
    "hooks:uninstall": "node scripts/hooks.mjs uninstall"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "@vercel/analytics": "^2.0.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.34.0",
    "maplibre-gl": "^6.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.32",
    "sharp": "0.35.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.4",
    "vitest": "^4.1.12"
  }
}
