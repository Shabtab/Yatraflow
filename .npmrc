; vite 8 + @vitejs/plugin-react 4.x: the plugin's peer range predates vite 8, but the
; combo is verified green by npm run verify (typecheck, 128/128 tests, vite build).
; Relax strict peer resolution until @vitejs/plugin-react is bumped to v6
; (native vite 8 support) -- see CHANGELOG Unreleased, Toolchain entry.
legacy-peer-deps=true
